# Maintainer: Thea Nicoline Flink <thea@nekothecatgirl.com>
pkgname=todo
pkgver=1.1.1
pkgrel=1
pkgdesc="A stupidly simple TUI todolist made in pure C using ncurses"
arch=('x86_64')
license=('MIT')
depends=('ncurses' 'json-c')
makedepends=('cmake')
source=("https://github.com/NekoTheCatgirl/todo/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('351f9e67a9ceb83f673e0302f6616c36948affee73fdefc1057d2873d994f3f0')

build() {
    cd "$pkgname-$pkgver"
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
}